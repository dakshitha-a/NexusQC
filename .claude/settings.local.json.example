{
  "//": "Optional, opt-in. Copy to .claude/settings.local.json (gitignored) to",
  "//2": "have Claude Code run scripts/check_public_safe.sh before a `git push`",
  "//3": "it issues, blocking the push if host paths or credentials would ship.",
  "//4": "Pushes to a private remote (origin) are skipped, matching the git hook.",
  "//5": "This duplicates the git pre-push hook installed by",
  "//6": "scripts/hooks/install.sh, which is the guard that actually cannot be",
  "//7": "bypassed by tooling. Claude Code merges this file with the tracked",
  "//8": ".claude/settings.json, which carries the plan-amendment hooks; this",
  "//9": "one stays opt-in because it makes every Bash tool call shell out to",
  "//10": "python3, a cost the event-scoped hooks in the tracked file do not have.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/claude_push_guard.py\""
          }
        ]
      }
    ]
  }
}

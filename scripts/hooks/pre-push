#!/usr/bin/env bash
#
# Block a push that would publish host-specific paths or credentials.
#
# Install (once per clone -- git does not track .git/hooks itself):
#
#     ln -sf ../../scripts/hooks/pre-push .git/hooks/pre-push
#
# or run: scripts/hooks/install.sh
#
# TWO SCANS, DELIBERATELY
# -----------------------
# 1. The working tree, which is what the public repository will contain.
# 2. The commits actually being pushed, which the working tree cannot show you:
#    content committed and then removed in a later commit leaves a clean tree
#    and a permanent leak in history. That is not hypothetical -- this
#    repository needed a full history rewrite to clear exactly that.
#
# Bypass for a single push, if you are certain the finding is spurious:
#
#     git push --no-verify
#
# Prefer narrowing the pattern in scripts/check_public_safe.sh over making a
# habit of --no-verify: the whole point is that this cannot be forgotten.

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
CHECK="$ROOT/scripts/check_public_safe.sh"

if [ ! -x "$CHECK" ]; then
    echo "pre-push: $CHECK missing or not executable; skipping scan." >&2
    exit 0
fi

FAILED=0

echo "pre-push: scanning the working tree..."
"$CHECK" || FAILED=1

# Git feeds the hook one line per ref being pushed, on stdin:
#     <local-ref> <local-sha> <remote-ref> <remote-sha>
# An all-zero sha means "does not exist": local zero is a branch deletion
# (nothing to scan), remote zero is a branch the remote has never seen.
ZERO="$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')"
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ -n "${local_sha:-}" ] || continue
    [ "$local_sha" = "$ZERO" ] && continue          # deleting a ref

    if [ "$remote_sha" = "$ZERO" ]; then
        # New branch on the remote. There is no previous state to diff
        # against, so scan everything reachable from it that is not already
        # on some other remote-tracking branch -- this keeps a first push of
        # a fresh repository from scanning nothing at all.
        RANGE="$local_sha --not --remotes"
    else
        RANGE="${remote_sha}..${local_sha}"
    fi

    echo "pre-push: scanning commits being pushed (${RANGE})..."
    "$CHECK" --range "$RANGE" || FAILED=1
done

if [ "$FAILED" -eq 0 ]; then
    exit 0
fi

cat >&2 <<'EOF'

pre-push: REFUSING TO PUSH.

The scan above found content that should not be published. Fix it, or if it
is a false positive, narrow the pattern in scripts/check_public_safe.sh.

Remember the asymmetry: a private push can be rewritten, a public one cannot.
EOF
exit 1

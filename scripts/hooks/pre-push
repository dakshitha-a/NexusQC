#!/usr/bin/env bash
#
# Block a push that would publish host-specific paths or credentials.
#
# Install (once per clone -- git does not track .git/hooks itself):
#
#     ln -sf ../../scripts/hooks/pre-push .git/hooks/pre-push
#
# or run: scripts/hooks/install.sh
#
# PRIVATE REMOTES ARE NOT SCANNED
# -------------------------------
# The scan exists to keep host paths and credentials out of the PUBLIC
# repository. `origin` (NexusQC-dev) is private and stays private, so scanning
# every development push spent time defending against a disclosure that cannot
# happen there. Pushes to a private remote are therefore waved through.
#
# What keeps that sound is that publication does not depend on this hook at
# all: scripts/release.sh -- the only route to the public remote -- runs
# check_public_safe.sh itself before it pushes anything. If that call is ever
# removed from release.sh, this exemption has to go with it.
#
# Anything not recognised as private IS scanned, including a remote nobody has
# taught this hook about. Defaulting an unknown remote to "probably fine" is
# how the guarantee would quietly rot.
#
# TWO SCANS, DELIBERATELY (when a scan does run)
# ----------------------------------------------
# 1. The working tree, which is what the public repository will contain.
# 2. The commits actually being pushed, which the working tree cannot show you:
#    content committed and then removed in a later commit leaves a clean tree
#    and a permanent leak in history. That is not hypothetical -- this
#    repository needed a full history rewrite to clear exactly that.
#
# Bypass for a single push, if you are certain the finding is spurious:
#
#     git push --no-verify
#
# Prefer narrowing the pattern in scripts/check_public_safe.sh over making a
# habit of --no-verify: the whole point is that this cannot be forgotten.

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
CHECK="$ROOT/scripts/check_public_safe.sh"

# Git passes the remote's name as $1 and its URL as $2.
REMOTE_NAME="${1:-}"
REMOTE_URL="${2:-}"

# Private remotes, by name and by URL. QC_AGENT_PRIVATE_REMOTES can name
# additional ones (space-separated) for a fork or a second private mirror.
PRIVATE_REMOTES="origin ${QC_AGENT_PRIVATE_REMOTES:-}"
PRIVATE_URL_PATTERN="${QC_AGENT_PRIVATE_URL_PATTERN:-NexusQC-dev}"

for private in $PRIVATE_REMOTES; do
    [ -n "$private" ] || continue
    if [ "$REMOTE_NAME" = "$private" ]; then
        # Match on the URL too, so a remote renamed to "origin" but pointing at
        # the public repository is still scanned. The name is a label; the URL
        # is where the data actually goes.
        if [ -z "$REMOTE_URL" ] || printf '%s' "$REMOTE_URL" | grep -q "$PRIVATE_URL_PATTERN"; then
            echo "pre-push: $REMOTE_NAME is private; skipping the public-safety scan." >&2
            echo "pre-push: (scripts/release.sh scans on its own before publishing.)" >&2
            exit 0
        fi
        echo "pre-push: '$REMOTE_NAME' does not look like the private remote" >&2
        echo "pre-push: (url: $REMOTE_URL) -- scanning anyway." >&2
    fi
done

if [ ! -x "$CHECK" ]; then
    echo "pre-push: $CHECK missing or not executable; skipping scan." >&2
    exit 0
fi

FAILED=0

echo "pre-push: scanning the working tree..."
"$CHECK" || FAILED=1

# Git feeds the hook one line per ref being pushed, on stdin:
#     <local-ref> <local-sha> <remote-ref> <remote-sha>
# An all-zero sha means "does not exist": local zero is a branch deletion
# (nothing to scan), remote zero is a branch the remote has never seen.
ZERO="$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')"
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ -n "${local_sha:-}" ] || continue
    [ "$local_sha" = "$ZERO" ] && continue          # deleting a ref

    if [ "$remote_sha" = "$ZERO" ]; then
        # New branch on the remote. There is no previous state to diff
        # against, so scan everything reachable from it that is not already
        # on some other remote-tracking branch -- this keeps a first push of
        # a fresh repository from scanning nothing at all.
        RANGE="$local_sha --not --remotes"
    elif ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
        # The remote advertises a tip we do not have. This is not an edge case:
        # it is the normal state of a force-push after a history rewrite, where
        # every sha changed and the pre-rewrite objects were repacked away. A
        # "<unknown>..<local>" range cannot resolve, and the whole point of this
        # hook is that the push it cannot check is the push it must not wave
        # through -- so widen to everything being pushed rather than narrowing
        # to nothing.
        echo "pre-push: remote tip ${remote_sha} is unknown locally" >&2
        echo "pre-push: (expected after a history rewrite) scanning all of ${local_sha} instead" >&2
        RANGE="$local_sha --not --remotes"
    else
        RANGE="${remote_sha}..${local_sha}"
    fi

    echo "pre-push: scanning commits being pushed (${RANGE})..."
    "$CHECK" --range "$RANGE" || FAILED=1
done

if [ "$FAILED" -eq 0 ]; then
    exit 0
fi

cat >&2 <<'EOF'

pre-push: REFUSING TO PUSH.

The scan above found content that should not be published. Fix it, or if it
is a false positive, narrow the pattern in scripts/check_public_safe.sh.

Remember the asymmetry: a private push can be rewritten, a public one cannot.
EOF
exit 1

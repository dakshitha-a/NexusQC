# Runtime data -- job outputs, caches, uploads, conversation state.
# None of this is source; all of it regenerates or is user-specific.
data/jobs/*
data/molecules/*
data/kb/*
data/uploads/*
data/geometry_uploads/*
data/scraped/*
data/bse_basis_cache/*
# Charts the app draws. Regenerated on demand, specific to one user's own
# jobs, and PNGs that check_public_safe.sh cannot scan -- the same reasons
# data/bug_reports/ is ignored just below.
data/plots/*
# Deployment requests and progress. The api writes a request here and
# scripts/deploy_runner.sh answers into it; nginx also serves it read-only at
# /deploy-status/ so a browser can watch an update while the api is restarting.
# All of it is per-deployment runtime state.
data/deploy/*
!data/deploy/.gitkeep
# Screenshots users attach to bug reports. Images, so check_public_safe.sh
# cannot scan them -- and they are by nature pictures of someone's actual
# session, which is exactly what must not reach a public push.
data/bug_reports/*
data/agent_checkpoints.sqlite*
data/threads.json
# project archives, the sibling registry -- see app/projects/registry.py
data/projects.json
!data/jobs/.gitkeep
!data/molecules/.gitkeep
!data/kb/.gitkeep
!data/uploads/.gitkeep
!data/geometry_uploads/.gitkeep
!data/bse_basis_cache/.gitkeep
!data/plots/.gitkeep
!data/bug_reports/.gitkeep

__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

.env
# The installer keeps a timestamped copy when it reconfigures, and that copy
# holds the same live Postgres password and JWT signing secret the real file
# does. Ignoring only `.env` left them a `git add -A` away from being
# committed.
.env.bak.*
*.log

# ...except an evaluation's own evidence logs, which are the record of the run
# rather than build noise. docs/TRACKER.md's `evidence:` paths point at these
# directories and the READMEs in them quote numbers a reader is invited to
# check, so the before/after logs behind those numbers have to be in the
# repository or the citation goes nowhere. Caught during the 2026-09 fix
# phase: ninety-six logs had accumulated under
# docs/evaluation/2026-09-app-review/evidence/ and not one of them was
# tracked, so every evidence directory in the tracker held only its README.
# All of them together are under 1.5 MB.
!docs/evaluation/**/evidence/**/*.log

# The redactor's list of host identifiers that cannot be derived from the
# environment (a hostname, an address, an email a test printed). It is the one
# place the real strings are allowed to exist, and it stays on the host they
# describe. See docs/evaluation/*/evidence/redact_paths.py.
docs/evaluation/**/evidence/redact_terms.local

# Site-specific Docker Compose overrides -- bind-mount paths for the
# licensed QC engines (ORCA/BAGEL). See docker-compose.override.yml.example.
docker-compose.override.yml

# Append-only record of what this deployment has updated to and when.
# Written by scripts/update.sh, read by --rollback. Untracked because it is
# the history of one deployment, not of the code.
.update-log

# scripts/backup.sh's fallback location when QC_AGENT_BACKUP_DIR is unset. It
# should be pointed outside the repository (the script warns when it is not),
# but a database dump must never become a tracked file OR leave the checkout
# dirty -- a dirty tree blocks the next update.
/backups/

# Host-specific notes for the coding agent: absolute paths, install
# locations and "on this particular machine" observations. The committed
# CLAUDE.md holds only the generic working agreements.
CLAUDE.local.md

# Per-machine Claude Code settings (permissions, local hooks).
.claude/settings.local.json
# Claude Code creates git worktrees here. They are scratch checkouts of this
# same repository, and leaving them untracked made `scripts/update.sh` refuse
# to run: it requires a clean tree so a rollback has something to return to,
# and an untracked directory full of worktrees reads as local modifications.
.claude/worktrees/

# The docs/e2e-* review documents used to be listed here as "internal notes".
# They are deliberately TRACKED and public now: docs/ROADMAP.md is built from
# them, the improvement plan is the queue of unimplemented features, and the
# fix-verification record is what distinguishes a verified fix from a
# code-complete one. Listing tracked files here had no effect anyway -- gitignore
# does not untrack -- so the entries were misleading rather than protective.
docs/ARCHITECTURE-full.md

# Test-provisioned admin credentials for tests/ (see tests/backend/_00_bootstrap.py)
tests/.admin_creds
# Which jobs existed before a suite run started. Written by
# tests/backend/_00_bootstrap.py, consumed and removed by
# tests/backend/zz_99_job_cleanup.py -- per-run bookkeeping, never source.
tests/.jobs_before_run
# Its sibling, same reason: a per-run snapshot of what existed before the
# suite started, written by _00_bootstrap.py and consumed by the cleanup
# scripts. Tracked by accident; it is machine state, not project state, and
# a run leaves the checkout dirty while it is.
tests/.threads_before_run
# Symlink to frontend/node_modules so tests/frontend/*.mjs can resolve the
# `playwright` package via Node's normal ESM directory-walk resolution --
# recreate with: ln -s ../../frontend/node_modules tests/frontend/node_modules
tests/frontend/node_modules

# Screenshots written by tests/e2e/ui's shot() helper. Machine-generated, and
# regenerated on every run -- but the real reason they must not be committed is
# that scripts/check_public_safe.sh cannot read images, so anything a screenshot
# happens to capture (a username, an invite token, a file path) would bypass the
# only automated check standing between this tree and a public push.
docs/e2e-artifacts/

.DS_Store

# TLS certs/keys for the nginx deployment -- provisioned per-deployment
# (internal CA / self-signed for intranet, certbot or similar for public),
# never committed.
nginx/certs/*
!nginx/certs/.gitkeep

# Journal manuscript draft, deliberately local-only (never push)
rsc_digital_discovery/

# Job artifacts a CAS recommendation writes into the working directory when it
# is driven directly rather than through the job manager. They are outputs, not
# source, and one of them is a binary image.
active_space_spec.json
orbitals.molden
orbital_ranking.png

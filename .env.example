# Copy to .env and fill in before `docker compose up`. Never commit the
# real .env (already in .gitignore).

# --- Required, no safe default ----------------------------------------------
QC_AGENT_POSTGRES_PASSWORD=change-me
# At least 32 bytes -- PyJWT warns (InsecureKeyLengthWarning) on anything
# shorter for HS256. Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
QC_AGENT_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
QC_AGENT_REDIS_URL=redis://redis:6379/0

# --- Postgres (defaults shown are what docker-compose.yml falls back to) ---
QC_AGENT_POSTGRES_DB=qc_agent
QC_AGENT_POSTGRES_USER=qc_agent

# --- LLM chat inference -------------------------------------------------
# Default points at the host's existing Ollama install (Phase 1/early
# deployment). Repoint at http://vllm:8000/v1 once the vllm service in
# docker-compose.yml is uncommented and its tool-calling behavior has been
# verified against this app's real traffic -- see the deployment plan's
# Phase 0/5 notes. No code change is needed either way.
QC_AGENT_LLM_BASE_URL=http://host.docker.internal:11434/v1
QC_AGENT_LLM_MODEL=qwen3.8:27b

# --- vLLM (only read if the vllm service is uncommented) -------------------
# QC_AGENT_VLLM_MODEL=                # a real FP8 or AWQ Qwen3-30B checkpoint id
# QC_AGENT_LLM_GPU_IDS=0              # comma-separated GPU indices this app may
#                                      # claim persistently on a shared host --
#                                      # never "all of them" by default
# QC_AGENT_LLM_TP_SIZE=1              # must equal the number of GPU ids above
# QC_AGENT_VLLM_GPU_MEM_UTIL=0.65
# QC_AGENT_VLLM_MAX_MODEL_LEN=32768

# --- Lab-supplied QC software (licensed, host-installed -- see docker-compose.yml) ---
# Adjust the host-side bind-mount source paths in docker-compose.yml itself
# to match your install locations; these env vars just tell the app where
# they land *inside* the container (defaults already match the mount paths).
# QC_AGENT_ORCA_BIN=/opt/Orca-6.1.1/orca
# QC_AGENT_BAGEL_BIN=/opt/bagel-1.2.2/bin/BAGEL
# QC_AGENT_BAGEL_SETVARS=/opt/intel/oneapi/setvars.sh

# --- nginx (used only by docker-compose.yml's port binding, not the app itself) ---
# The intranet HTTPS listener (port 8443) is published on these two
# addresses and NOWHERE else. Naming them explicitly, rather than binding
# 0.0.0.0 and relying on nginx's CIDR allowlist, means a host with a
# publicly routable address never has that address bound at all -- the
# allowlist stays as defence in depth instead of being the only gate.
# Both are required; compose refuses to start without them.
QC_AGENT_LAN_BIND=<this-hosts-internal-lan-ip>
QC_AGENT_TAILSCALE_BIND=<this-hosts-tailnet-ip>

# --- backups (scripts/backup.sh) -------------------------------------------
# Point at a filesystem with room. Defaults to /data/qcuser/nexusqc-backups.
# QC_AGENT_BACKUP_DIR=/data/qcuser/nexusqc-backups
# QC_AGENT_BACKUP_RETAIN_DAYS=30

# --- TLS certificate (scripts/gen_intranet_cert.sh) ------------------------
# The FQDN written into the certificate's subjectAltName. Must match what
# users actually type in the browser, or verification fails.
# QC_AGENT_CERT_FQDN=<this-hosts-fqdn>
# QC_AGENT_CERT_DAYS=3650

# --- container file ownership (F-004) ---
# The api container writes job artifacts and KB uploads into the
# bind-mounted ./data directory. A bind mount preserves the writing
# process's uid verbatim onto the host filesystem, so these decide who owns
# those files on the HOST. Set them to the operator's own ids -- run
# `id -u` and `id -g` -- or everything the container writes ends up owned
# by a uid you cannot delete without sudo.
APP_UID=1000
APP_GID=1000
